# 🐳 DOCKER PRODUCTION ENVIRONMENT
# Copy this file to .env.docker and configure your values

# === DATABASE CONFIGURATION ===
POSTGRES_DB=z_app_production
POSTGRES_USER=z_app_user
POSTGRES_PASSWORD=your_secure_database_password_change_this_now

# === BACKEND CONFIGURATION ===
NODE_ENV=production
PORT=5001
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters_long_change_this
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_change_this

# === FRONTEND URLS ===
# Update with your actual domain
FRONTEND_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# For local development, use:
# FRONTEND_URL=http://localhost
# CLIENT_URL=http://localhost

# === CLOUDINARY (REQUIRED FOR IMAGE UPLOADS) ===
CLOUDINARY_CLOUD_NAME=dsol2p21u
CLOUDINARY_API_KEY=455557543893756
CLOUDINARY_API_SECRET=MyvMZN6iRSisWvX5SL-tDMsWCv4

# === EMAIL SERVICE (OPTIONAL) ===
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM="Z-App <noreply@yourdomain.com>"

# === REDIS CONFIGURATION (OPTIONAL) ===
REDIS_PASSWORD=your_secure_redis_password_change_this

# === SSL CONFIGURATION (OPTIONAL) ===
# For Let's Encrypt SSL
SSL_EMAIL=your_email@yourdomain.com
DOMAIN=yourdomain.com

# === SECURITY SETTINGS ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your_super_secure_session_secret_change_this
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# === MONITORING & LOGGING ===
LOG_LEVEL=error
ENABLE_LOGGING=true

# === PERFORMANCE SETTINGS ===
MAX_REQUEST_SIZE=50mb
REQUEST_TIMEOUT=30000
SOCKET_TIMEOUT=60000

# === DOCKER SPECIFIC ===
COMPOSE_PROJECT_NAME=z-app
RESTART_POLICY=unless-stopped