# 🚀 RENDER BACKEND PRODUCTION ENVIRONMENT
# Copy these variables to your Render dashboard

# === REQUIRED VARIABLES ===
NODE_ENV=production
PORT=10000

# Database - PostgreSQL (Render provides free PostgreSQL)
# Get this from Render PostgreSQL service dashboard
DATABASE_URL=postgresql://username:password@dpg-xxxxx-a.oregon-postgres.render.com/database_name

# Security - CHANGE THESE VALUES!
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters_long_for_production_render
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_change_this

# === FRONTEND URLS ===
# Update with your Vercel domain
CLIENT_URL=https://your-app-name.vercel.app
FRONTEND_URL=https://your-app-name.vercel.app

# === CLOUDINARY (REQUIRED FOR IMAGE UPLOADS) ===
CLOUDINARY_CLOUD_NAME=dsol2p21u
CLOUDINARY_API_KEY=455557543893756
CLOUDINARY_API_SECRET=MyvMZN6iRSisWvX5SL-tDMsWCv4

# === EMAIL SERVICE (OPTIONAL) ===
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM="Z-App <noreply@yourdomain.com>"

# === REDIS (OPTIONAL - FOR SCALING) ===
# Uncomment if you add Redis service on Render
# REDIS_URL=redis://red-xxxxx:6379

# === PERFORMANCE & SECURITY ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your_super_secure_session_secret_for_render_deployment
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# === MONITORING ===
LOG_LEVEL=error
ENABLE_LOGGING=true

# === RENDER SPECIFIC ===
RENDER=true
RENDER_SERVICE_NAME=z-app-backend